#!/usr/bin/env bash
set -euo pipefail

PROJECT_NAME="{{PROJECT_NAME}}"
PROJECT_PATH="{{PROJECT_PATH}}"
BRANCH="{{BRANCH}}"
PM2_NAME="{{PM2_NAME}}"
PORT="{{PORT}}"
REPO_URL="{{REPO_URL}}"

echo "Preparing first deployment for ${PROJECT_NAME}"

if [ ! -d "${PROJECT_PATH}/.git" ]; then
  mkdir -p "${PROJECT_PATH}"
  git clone --branch "${BRANCH}" "${REPO_URL}" "${PROJECT_PATH}"
fi

cd "${PROJECT_PATH}"
git fetch origin "${BRANCH}"
git checkout "${BRANCH}"
git pull origin "${BRANCH}"
npm install
npm run build

if pm2 describe "${PM2_NAME}" >/dev/null 2>&1; then
  pm2 restart "${PM2_NAME}"
else
  pm2 start "npx next start -p ${PORT}" --name "${PM2_NAME}"
fi

pm2 save
